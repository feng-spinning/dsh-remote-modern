{
  "name": "dsh-remote-modern",
  "version": "0.1.2",
  "description": "SSH remote backends for DeepSeek Harness: connect the Web/Desktop client to a persistent dsh backend on a remote host, with the remote workspace, sessions, files and terminals served by that host.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "ssh",
    "remote",
    "socks",
    "remote-development"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "icon": "./assets/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feng-spinning/dsh-remote-modern.git"
  },
  "homepage": "https://github.com/feng-spinning/dsh-remote-modern#readme",
  "bugs": {
    "url": "https://github.com/feng-spinning/dsh-remote-modern/issues"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.0-rc.2"
  },
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-isolation=none test/*.test.js",
    "test:integration": "node test/supervisor.integration.js",
    "check": "npm run build && npm test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
